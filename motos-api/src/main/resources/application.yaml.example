ktor:
  deployment:
    port: 8080
  application:
    modules:
      - com.monarca.HttpKt.configureHttp
      - com.monarca.SerializationKt.configureSerialization
      - com.monarca.StatusPagesKt.configureStatusPages
      - com.monarca.KoinKt.configureKoin
      - com.monarca.auth.AuthKt.configureAuthentication
      - com.monarca.auth.http.AuthRoutingKt.configureAuthRoutes
      - com.monarca.localidade.http.LocalidadeRoutingKt.configureLocalidade
      - com.monarca.pessoa.http.PessoaRoutingKt.configurePessoa
      - com.monarca.usuario.http.UsuarioRoutingKt.configureUsuario

database:
  url: "r2dbc:postgresql://localhost:5432/monarca_motos_db"
  user: postgres
  password: "CHANGE_ME"

jwt:
  secret: "CHANGE_ME-min-32-characters-secret"
  issuer: "monarca-motos"
  audience: "monarca-motos-api"
  realm: "Monarca Motos"
  accessExpirationMinutes: 60
  refreshExpirationDays: 7
